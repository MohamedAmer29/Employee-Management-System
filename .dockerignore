# ---------------------------------------------------------------------------
# Docker build context exclusions.
#
# This is intentionally NOT a copy of .gitignore. Its purpose is to keep the
# build context small and to guarantee secrets never reach an image layer.
#
# Build-critical files (package.json, package-lock.json, tsconfig.json,
# tsconfig.build.json, nest-cli.json, src/) are deliberately NOT excluded.
# ---------------------------------------------------------------------------

# Dependencies - reinstalled inside the image with `npm ci`.
# Excluding these also prevents host-built native modules (bcrypt) from
# leaking into a Linux image and breaking at runtime.
node_modules
**/node_modules

# Build output - regenerated by the build stage.
dist
build
coverage
.nyc_output

# Secrets. NOTE: .env is deliberately re-included (!.env) so the production
# stage can COPY it into the image (/app/.env). This bakes credentials into
# every image layer - only do this for private/trusted registries, never for a
# public Docker Hub repo.
.env
.env.*
!.env.example
!.env

# Version control
.git
.gitignore
.gitattributes
.github

# Docker files themselves
Dockerfile
Dockerfile.*
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Tests - not needed to build or run production
test
tests
**/*.spec.ts
**/*.test.ts
**/*.e2e-spec.ts

# Tooling / lint config not required by `nest build`
eslint.config.mjs
.prettierrc
.editorconfig

# Editors and OS noise
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Logs and runtime artifacts
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock

# Docs and local assets
README.md
*.md
image
uploads
.temp
.tmp
