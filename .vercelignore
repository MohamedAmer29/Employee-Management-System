# Keep the deployment to the compiled output only.
#
# src/ MUST stay in the upload - `npm run build` (Vercel buildCommand) needs
# it. The per-file transpile that caused the unresolved "@/..." runtime errors
# was Vercel's NestJS framework auto-detection. It is disabled via
# "framework": null in vercel.json, so Vercel runs our buildCommand and bundles
# only the api/index.js entrypoint + dist/** (see vercel.json includeFiles).

node_modules
coverage
.nyc_output

.git
.github

.env
.env.*
!.env.example

Dockerfile
Dockerfile.*
docker-compose.yml
docker-compose.*.yml
.dockerignore

test
tests
**/*.spec.ts
**/*.test.ts
**/*.e2e-spec.ts

.vscode
.idea
*.log
image
uploads
README.md
